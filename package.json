{
  "name": "better-auth-waitlist",
  "version": "4.0.0",
  "description": "A complete waitlist for Better Auth: a live queue, status links, referrals, invites and invite-only sign-up",
  "author": "Seifeddine Largat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slargat/better-auth-waitlist.git"
  },
  "homepage": "https://github.com/slargat/better-auth-waitlist#readme",
  "bugs": "https://github.com/slargat/better-auth-waitlist/issues",
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "waitlist",
    "invite",
    "auth"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./types": "./dist/types.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && node scripts/check-client-graph.mjs && node scripts/check-dts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --project unit",
    "test:postgres": "vp test run --project postgres",
    "test:postgres:local": "scripts/test-postgres-local.sh",
    "lint": "vp lint && vp fmt --check",
    "fmt": "vp fmt",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "pnpm run build && changeset publish"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@better-auth/core": "^1.7.0",
    "better-auth": "^1.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@better-auth/core": "1.7.10",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^25.4.0",
    "@types/pg": "^8.18.0",
    "better-auth": "1.7.10",
    "msw": "2.12.10",
    "pg": "^8.20.0",
    "publint": "^0.3.21",
    "typescript": "6.0.3",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.11.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  }
}
